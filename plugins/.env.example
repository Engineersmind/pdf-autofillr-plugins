# ============================================================
# pdf-autofillr-plugins — environment reference
#
# The plugin framework itself has zero runtime dependencies
# and needs no environment variables.
#
# If your custom plugins call external services (e.g. an LLM
# for a custom extractor, or an API for a custom validator),
# add their keys here and load them inside your plugin via:
#
#     import os
#     api_key = os.getenv("MY_PLUGIN_API_KEY")
#
# ============================================================


# ── Example: custom extractor that calls an LLM ──────────────
# MY_EXTRACTOR_LLM_PROVIDER=openai
# MY_EXTRACTOR_LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=sk-...

# ── Example: custom validator that calls an external API ──────
# MY_VALIDATOR_API_URL=https://api.example.com/validate
# MY_VALIDATOR_API_KEY=your-api-key

# ── Example: custom storage backend ──────────────────────────
# MY_PLUGIN_STORAGE_BUCKET=my-bucket
# MY_PLUGIN_STORAGE_REGION=us-east-1
